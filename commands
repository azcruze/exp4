Pipeline Script
Paste this under Pipeline → Pipeline script.
pipeline {
    agent any

    stages {
        stage('Generate site') {
            steps {
                script {
                    sh 'mkdir -p site/assets'

                    writeFile file: 'site/index.html', text: '''
                    <html>
                    <head>
                        <title>Karunya University</title>
                        <link rel="stylesheet" href="assets/style.css">
                    </head>
                    <body>
                        <h1>Welcome to Karunya University</h1>
                        <p>DevOps Lab - Jenkins Deployment Using Docker</p>
                    </body>
                    </html>
                    '''

                    writeFile file: 'site/assets/style.css', text: '''
                    body {
                        font-family: Arial;
                        text-align: center;
                        background-color: lightblue;
                        padding: 50px;
                    }
                    h1 {
                        color: darkblue;
                    }
                    '''
                }
            }
        }

        stage('Publish site') {
            steps {
                publishHTML(target: [
                    reportName: 'Karunya University - Simple Site',
                    reportDir: 'site',
                    reportFiles: 'index.html',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])

                archiveArtifacts artifacts: 'site/**/*',
                                 fingerprint: true
            }
        }
    }
}


